rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['loveaphair@gmail.com', 'fredalyssa@gmail.com'];
    }

    function contestState() {
      return exists(/databases/$(database)/documents/config/contest)
        ? get(/databases/$(database)/documents/config/contest).data.state
        : 'registration';
    }

    function couplePath(id) {
      return /databases/$(database)/documents/couples/$(id);
    }

    function ballotPath(id) {
      return /databases/$(database)/documents/ballots/$(id);
    }

    function slotPath(id) {
      return /databases/$(database)/documents/slots/$(id);
    }

    // A ballot is only valid together with a couple slot claim (max 2 per couple,
    // across all devices) created in the same batch for that exact ballot.
    function claimsSlot(coupleId, ballotId) {
      return (existsAfter(slotPath(coupleId + '_1'))
          && getAfter(slotPath(coupleId + '_1')).data.ballotId == ballotId)
        || (existsAfter(slotPath(coupleId + '_2'))
          && getAfter(slotPath(coupleId + '_2')).data.ballotId == ballotId);
    }

    // A device's second ballot must be for the same couple as its first.
    function sameCoupleAsFirst(ballotId, coupleId) {
      return ballotId.matches('.*_1')
        || (existsAfter(ballotPath(ballotId.replace('_2$', '_1')))
          && getAfter(ballotPath(ballotId.replace('_2$', '_1'))).data.coupleId == coupleId);
    }

    function validBallot(d, ballotId) {
      return d.keys().hasOnly(['coupleId', 'picks', 'createdAt'])
        && d.keys().hasAll(['coupleId', 'picks', 'createdAt'])
        && d.createdAt == request.time
        && d.coupleId is string
        && exists(couplePath(d.coupleId))
        && d.picks.keys().hasOnly(['icons', 'foolish', 'effort'])
        && d.picks.keys().hasAll(['icons', 'foolish', 'effort'])
        && d.picks.icons is string && d.picks.foolish is string && d.picks.effort is string
        && d.picks.icons != d.coupleId
        && d.picks.foolish != d.coupleId
        && d.picks.effort != d.coupleId
        && d.picks.icons != d.picks.foolish
        && d.picks.icons != d.picks.effort
        && d.picks.foolish != d.picks.effort
        && exists(couplePath(d.picks.icons))
        && exists(couplePath(d.picks.foolish))
        && exists(couplePath(d.picks.effort))
        && claimsSlot(d.coupleId, ballotId)
        && sameCoupleAsFirst(ballotId, d.coupleId);
    }

    match /config/contest {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['state', 'tiebreaks'])
        && request.resource.data.state in ['registration', 'voting', 'revealed']
        && (!('tiebreaks' in request.resource.data)
          || (request.resource.data.tiebreaks is map
            && request.resource.data.tiebreaks.keys().hasOnly(['icons', 'foolish', 'effort'])));
    }

    match /couples/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ballots/{uid}_{1|2}: each device (anonymous uid) may cast at most 2 ballots,
    // so a couple sharing one phone can still vote twice.
    match /ballots/{ballotId} {
      allow read: if isAdmin()
        || (signedIn() && ballotId in [request.auth.uid + '_1', request.auth.uid + '_2'])
        || (signedIn() && contestState() == 'revealed');
      allow create: if signedIn()
        && ballotId in [request.auth.uid + '_1', request.auth.uid + '_2']
        && contestState() == 'voting'
        && validBallot(request.resource.data, ballotId);
      allow delete: if isAdmin();
    }

    // slots/{coupleId}_{1|2}: create-only claims that cap ballots at 2 per couple.
    match /slots/{slot} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && contestState() == 'voting'
        && request.resource.data.keys().hasOnly(['uid', 'coupleId', 'ballotId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ballotId in [request.auth.uid + '_1', request.auth.uid + '_2']
        && slot in [request.resource.data.coupleId + '_1', request.resource.data.coupleId + '_2']
        && existsAfter(ballotPath(request.resource.data.ballotId))
        && getAfter(ballotPath(request.resource.data.ballotId)).data.coupleId
          == request.resource.data.coupleId;
      allow delete: if isAdmin();
    }
  }
}
